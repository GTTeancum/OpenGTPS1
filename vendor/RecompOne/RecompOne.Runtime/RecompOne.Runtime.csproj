<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DefineConstants Condition="'$(OpenGTReleasePackage)' == 'true'">$(DefineConstants);OPENGT_RELEASE_PACKAGE</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
      <EmbeddedResource Include="Bios\Fonts\font1.raw" />
      <EmbeddedResource Include="Bios\Fonts\font2.raw" />
      <EmbeddedResource Include="Cdrom\V8LooseManifest.json" />
      <EmbeddedResource Include="Cdrom\V82LooseManifest.json" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="NVorbis" Version="0.10.5" />
      <PackageReference Include="ImGui.NET" Version="1.90.8.1" />
      <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
      <PackageReference Include="Silk.NET.Maths" Version="2.23.0" />
      <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
      <PackageReference Include="Silk.NET.SDL" Version="2.23.0" />
      <PackageReference Include="Vortice.Direct3D11" Version="2.4.2" />
      <PackageReference Include="Vortice.D3DCompiler" Version="2.4.2" />
      <PackageReference Include="Vortice.DXGI" Version="2.4.2" />
    </ItemGroup>

</Project>
